{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts"]
}
