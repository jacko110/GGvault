POSTGRES_DB=ggvault
POSTGRES_USER=ggvault
POSTGRES_PASSWORD=ggvault
DATABASE_URL=postgresql://ggvault:ggvault@localhost:5432/ggvault
REDIS_URL=redis://localhost:6379
APP_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
ADMIN_ORIGIN=http://localhost:3002
API_BASE_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000
# WEB_REDIS_URL defaults to REDIS_URL. Keep session Redis private.
# Production cookies require HTTPS by default. Local HTTP production testing only:
# WEB_COOKIE_SECURE=false
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes
ENABLE_TEST_CREDITS=true
BETA_MODE=true
MAX_OPEN_CHALLENGES_PER_USER=5
MAX_DAILY_CHALLENGES=20
MAX_STAKE_TEST_CREDITS=100
MAX_EVIDENCE_SIZE=52428800
MUTATION_RATE_LIMIT=60
INITIAL_TEST_CREDITS=100
CORS_ORIGIN=http://localhost:3000
EVIDENCE_STORAGE_DIR=storage/evidence
EVIDENCE_SCREENSHOT_MAX_BYTES=10485760
EVIDENCE_VIDEO_MAX_BYTES=52428800
EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4
EVIDENCE_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp4

# Non-withdrawable TEST credit settlement fee; integer basis points (0..10000).
PLATFORM_FEE_BPS=500
