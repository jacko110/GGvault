{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@ggvault/shared$": "<rootDir>/../../packages/shared/src",
    "^@ggvault/ledger$": "<rootDir>/../../packages/ledger/src",
    "^@ggvault/match-engine$": "<rootDir>/../../packages/match-engine/src"
  }
}
