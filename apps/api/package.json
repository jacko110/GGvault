{
  "name": "api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --env-file=../../.env node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --env-file=../../.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file=../../.env dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --ext .ts",
    "test": "node ../../scripts/test-api.cjs all",
    "test:watch": "node ../../scripts/test-api.cjs all --watch",
    "test:cov": "node ../../scripts/test-api.cjs all --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register jest",
    "test:e2e": "node ../../scripts/test-api.cjs e2e"
  },
  "dependencies": {
    "@ggvault/ledger": "*",
    "@ggvault/match-engine": "*",
    "@ggvault/shared": "*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.1",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.12",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "^5.19.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
